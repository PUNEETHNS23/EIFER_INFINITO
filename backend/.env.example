# -----------------------------------------------------------------------------
# INFINITO Backend Environment Variables
# -----------------------------------------------------------------------------

# Secret key used for signing JWT tokens.
# In production, use a strong random value.
SECRET_KEY=replace-with-a-long-random-secret

# Supabase/Postgres connection string.
# Prefer Supabase pooler URL on cloud hosts:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Comma-separated origins allowed by CORS.
# Replace with your deployed frontend URL(s).
CORS_ORIGINS=https://eifer-frontend.vercel.app,https://your-custom-domain.com

# Optional regex for Vercel preview URLs (scope this to your project slug).
# Example pattern for project-specific previews:
CORS_ORIGIN_REGEX=https://your-project-name(-git-[a-z0-9-]+-[a-z0-9-]+)?\.vercel\.app

# Keep false unless browser cookies/session credentials are intentionally used.
CORS_ALLOW_CREDENTIALS=false
