# -----------------------------------------------------------------------------
# INFINITO Backend Environment Variables
# -----------------------------------------------------------------------------

# Secret key used for signing JWT tokens. 
# In production, use a strong, random, and long string!
# You can generate one via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=fallback-dev-key

# Supabase/Postgres connection string (Direct connection for long-running backend).
# SQLAlchemy format:
# postgresql+psycopg2://postgres:[PASSWORD]@db.xyemjvedkaxgpeuyjtvv.supabase.co:5432/postgres?sslmode=require
#
# For local SQLite development instead, use:
# sqlite:///./sports.db
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR_SUPABASE_DB_PASSWORD]@db.xyemjvedkaxgpeuyjtvv.supabase.co:5432/postgres?sslmode=require

# Comma-separated list of origins that are allowed to make cross-origin requests.
# Set to * for local development, or specific domain for production.
# Example: https://infinito.yourdomain.com,https://www.infinito.yourdomain.com
CORS_ORIGINS=*
