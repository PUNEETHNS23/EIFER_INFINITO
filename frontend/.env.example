# -----------------------------------------------------------------------------
# INFINITO Frontend Environment Variables
# -----------------------------------------------------------------------------

# Base URL to the backend API.
# For local dev this is usually http://localhost:8000/api
# For production, this should be the absolute URL to your backend API, e.g., https://api.infinito.yourdomain.com/api
# Or a relative path like /api if frontend and backend are served from the same domain
VITE_API_BASE_URL=http://localhost:8000/api

# Base URL for the websocket connection
# Locally: ws://localhost:8000/api/ws/matches
# Production: wss://api.infinito.yourdomain.com/api/ws/matches
VITE_WS_BASE_URL=ws://localhost:8000/api/ws/matches
